@page "/leaderboard"
@model LeaderboardModel
@{
    ViewData["Title"] = "Leaderboard";
}

<h1 style="margin-top:8px">Leaderboard</h1>
<p class="muted">
    Full assessments only, from the web and the mobile app alike. Where an email
    was given, only that person's best sitting is kept.
</p>

<div class="metrics" style="margin-bottom:24px">
    <div class="metric">
        <div class="value tabular">@Model.Stats.RankedAttempts</div>
        <div class="label">Ranked entries</div>
    </div>
    <div class="metric">
        <div class="value tabular">@Model.Stats.Countries</div>
        <div class="label">Countries</div>
    </div>
    <div class="metric">
        <div class="value tabular">@(Model.Stats.TopIndex?.ToString() ?? "—")</div>
        <div class="label">Top score</div>
    </div>
    <div class="metric">
        <div class="value tabular">@Model.Stats.AverageIndex.ToString("0.0")</div>
        <div class="label">Average</div>
    </div>
</div>

<form method="get" class="filters">
    <label class="field" style="margin:0;flex:1;min-width:220px">
        <span>Country</span>
        <select name="country" onchange="this.form.submit()">
            <option value="">Everywhere</option>
            @foreach (var country in Model.Countries)
            {
                <option value="@country.Code" selected="@(Model.Country == country.Code)">
                    @country.Flag @country.Name
                </option>
            }
        </select>
    </label>
    <noscript><button class="btn secondary" type="submit">Filter</button></noscript>
</form>

<div class="card">
    @if (Model.Board.Rows.Count == 0)
    {
        <p class="muted" style="margin:0">
            @(Model.Country is null
                ? "Nobody has ranked yet. Take the full assessment and you will be first."
                : "No entries from this country yet.")
        </p>
    }
    else
    {
        <div class="table-wrap">
            <table class="board">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Name</th>
                        <th scope="col">Country</th>
                        <th scope="col">Score</th>
                        <th scope="col">Correct</th>
                        <th scope="col">Time</th>
                        <th scope="col"><span class="visually-hidden">Certificate</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Board.Rows)
                    {
                        <tr class="@(row.Rank <= 3 ? $"top-{row.Rank}" : "")">
                            <td class="rank">@row.Rank</td>
                            <td>@row.DisplayName</td>
                            <td>@LeaderboardModel.FlagOf(row.CountryCode) @LeaderboardModel.NameOf(row.CountryCode)</td>
                            <td class="score">@row.Index</td>
                            <td class="tabular">@row.Correct/@row.Total</td>
                            <td class="tabular">@($"{(int)row.Duration.TotalMinutes}m {row.Duration.Seconds:00}s")</td>
                            <td><a asp-page="/Certificate" asp-route-slug="@row.CertificateSlug">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Board.TotalPages > 1)
        {
            <nav class="pager">
                @if (Model.Board.HasPrevious)
                {
                    <a class="btn secondary" asp-route-country="@Model.Country" asp-route-page="@(Model.Board.Page - 1)">Previous</a>
                }
                <span class="muted small">Page @Model.Board.Page of @Model.Board.TotalPages</span>
                @if (Model.Board.HasNext)
                {
                    <a class="btn secondary" asp-route-country="@Model.Country" asp-route-page="@(Model.Board.Page + 1)">Next</a>
                }
            </nav>
        }
    }
</div>

@if (Model.Standings.Count > 0)
{
    <div class="card">
        <h2>By country</h2>
        <p class="small muted" style="margin-top:0">Ranked by average score, so a country with one strong entry can lead a country with many.</p>
        <div class="table-wrap">
            <table class="board">
                <thead>
                    <tr>
                        <th scope="col">Country</th>
                        <th scope="col">Entries</th>
                        <th scope="col">Best</th>
                        <th scope="col">Average</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var standing in Model.Standings)
                    {
                        <tr>
                            <td>
                                <a asp-route-country="@standing.CountryCode">
                                    @LeaderboardModel.FlagOf(standing.CountryCode) @LeaderboardModel.NameOf(standing.CountryCode)
                                </a>
                            </td>
                            <td class="tabular">@standing.Entries</td>
                            <td class="tabular">@standing.BestIndex</td>
                            <td class="tabular">@standing.AverageIndex.ToString("0.0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
